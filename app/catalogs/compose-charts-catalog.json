{
    "$defs": {
        "anyComponent": {
            "oneOf": [
                {
                    "$ref": "#/components/BarChart"
                },
                {
                    "$ref": "#/components/LineChart"
                },
                {
                    "$ref": "#/components/PieChart"
                },
                {
                    "$ref": "#/components/Sparkline"
                }
            ]
        },
        "anyFunction": {
            "oneOf": [
                {
                    "$ref": "#/functions/and"
                },
                {
                    "$ref": "#/functions/email"
                },
                {
                    "$ref": "#/functions/formatCurrency"
                },
                {
                    "$ref": "#/functions/formatDate"
                },
                {
                    "$ref": "#/functions/formatNumber"
                },
                {
                    "$ref": "#/functions/formatString"
                },
                {
                    "$ref": "#/functions/length"
                },
                {
                    "$ref": "#/functions/not"
                },
                {
                    "$ref": "#/functions/numeric"
                },
                {
                    "$ref": "#/functions/openUrl"
                },
                {
                    "$ref": "#/functions/or"
                },
                {
                    "$ref": "#/functions/pluralize"
                },
                {
                    "$ref": "#/functions/regex"
                },
                {
                    "$ref": "#/functions/required"
                },
                {
                    "$ref": "#/functions/setTheme"
                },
                {
                    "$ref": "#/functions/setThemeMode"
                }
            ]
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "catalogId": "urn:anysdui:compose-charts:1.0.0",
    "components": {
        "BarChart": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "categories": {
                            "$ref": "common_types.json#/$defs/DynamicStringList",
                            "description": "The category labels, one per bar group."
                        },
                        "component": {
                            "const": "BarChart"
                        },
                        "label": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "What the chart shows, announced by screen readers."
                        },
                        "modifier": {
                            "$ref": "anysdui_types.compose-charts.json#/$defs/ModifierOps",
                            "description": "Layout and styling modifiers to apply to the chart."
                        },
                        "onBarSelected": {
                            "$ref": "common_types.json#/$defs/Action",
                            "description": "Action executed when the user selects a bar.",
                            "x-default": "{}"
                        },
                        "series": {
                            "anyOf": [
                                {
                                    "items": {
                                        "additionalProperties": false,
                                        "properties": {
                                            "name": {
                                                "description": "The series name shown in the legend.",
                                                "type": "string"
                                            },
                                            "values": {
                                                "description": "The values in category order.",
                                                "items": {
                                                    "type": "number"
                                                },
                                                "maxItems": 500,
                                                "type": "array"
                                            }
                                        },
                                        "required": [
                                            "name",
                                            "values"
                                        ],
                                        "type": "object"
                                    },
                                    "maxItems": 12,
                                    "type": "array"
                                },
                                {
                                    "$ref": "common_types.json#/$defs/DataBinding"
                                }
                            ],
                            "description": "The series to draw, each a name and its values in category order. Bind it with a path, or give it inline."
                        },
                        "stacked": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "default": false,
                            "description": "Whether the series stack in one bar per category instead of standing side by side.",
                            "x-default": "false"
                        }
                    },
                    "required": [
                        "categories",
                        "component",
                        "label",
                        "series"
                    ]
                }
            ],
            "description": "Draws one or more series of numbers as grouped vertical bars over shared category labels.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "categories": {
                    "@path": "/visits/days"
                },
                "component": "BarChart",
                "id": "root",
                "label": "Visits per day",
                "modifier": [
                    {
                        "type": "fillMaxWidth"
                    },
                    {
                        "height": 200,
                        "type": "size"
                    }
                ],
                "series": {
                    "@path": "/visits/series"
                }
            },
            "x-stateSupport": [
                "focused",
                "hovered",
                "pressed"
            ]
        },
        "LineChart": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "LineChart"
                        },
                        "label": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "What the chart shows, announced by screen readers."
                        },
                        "modifier": {
                            "$ref": "anysdui_types.compose-charts.json#/$defs/ModifierOps",
                            "description": "Layout and styling modifiers to apply to the chart."
                        },
                        "onPointSelected": {
                            "$ref": "common_types.json#/$defs/Action",
                            "description": "Action executed when the user selects a point.",
                            "x-default": "{}"
                        },
                        "series": {
                            "anyOf": [
                                {
                                    "items": {
                                        "additionalProperties": false,
                                        "properties": {
                                            "name": {
                                                "description": "The series name shown in the legend.",
                                                "type": "string"
                                            },
                                            "values": {
                                                "description": "The values in x order.",
                                                "items": {
                                                    "type": "number"
                                                },
                                                "maxItems": 500,
                                                "type": "array"
                                            }
                                        },
                                        "required": [
                                            "name",
                                            "values"
                                        ],
                                        "type": "object"
                                    },
                                    "maxItems": 12,
                                    "type": "array"
                                },
                                {
                                    "$ref": "common_types.json#/$defs/DataBinding"
                                }
                            ],
                            "description": "The series to plot, each a name and its values in x order. Bind it with a path, or give it inline."
                        },
                        "xLabels": {
                            "$ref": "common_types.json#/$defs/DynamicStringList",
                            "description": "The x-axis labels, one per value position."
                        }
                    },
                    "required": [
                        "component",
                        "label",
                        "series",
                        "xLabels"
                    ]
                }
            ],
            "description": "Plots one or more series of numbers as lines over shared x-axis labels.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "LineChart",
                "id": "root",
                "label": "Monthly sales by region",
                "modifier": [
                    {
                        "type": "fillMaxWidth"
                    },
                    {
                        "height": 220,
                        "type": "size"
                    }
                ],
                "onPointSelected": {
                    "event": {
                        "name": "point_selected"
                    }
                },
                "series": {
                    "@path": "/sales/series"
                },
                "xLabels": {
                    "@path": "/sales/months"
                }
            },
            "x-stateSupport": [
                "focused",
                "hovered",
                "pressed"
            ]
        },
        "PieChart": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "PieChart"
                        },
                        "donut": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "default": false,
                            "description": "Whether the chart leaves a hole in the middle.",
                            "x-default": "false"
                        },
                        "label": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "What the chart shows, announced by screen readers."
                        },
                        "modifier": {
                            "$ref": "anysdui_types.compose-charts.json#/$defs/ModifierOps",
                            "description": "Layout and styling modifiers to apply to the chart."
                        },
                        "onSliceSelected": {
                            "$ref": "common_types.json#/$defs/Action",
                            "description": "Action executed when the user selects a slice.",
                            "x-default": "{}"
                        },
                        "slices": {
                            "anyOf": [
                                {
                                    "items": {
                                        "additionalProperties": false,
                                        "properties": {
                                            "label": {
                                                "description": "The slice label shown in the legend.",
                                                "type": "string"
                                            },
                                            "value": {
                                                "description": "The slice value; its share of the total sets the angle.",
                                                "minimum": 0,
                                                "type": "number"
                                            }
                                        },
                                        "required": [
                                            "label",
                                            "value"
                                        ],
                                        "type": "object"
                                    },
                                    "maxItems": 50,
                                    "type": "array"
                                },
                                {
                                    "$ref": "common_types.json#/$defs/DataBinding"
                                }
                            ],
                            "description": "The slices, each a label and a non-negative value. Bind it with a path, or give it inline."
                        }
                    },
                    "required": [
                        "component",
                        "label",
                        "slices"
                    ]
                }
            ],
            "description": "Draws parts of a whole as slices of a circle, largest first.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "PieChart",
                "donut": true,
                "id": "root",
                "label": "Budget by category",
                "modifier": [
                    {
                        "height": 220,
                        "type": "size",
                        "width": 220
                    }
                ],
                "slices": {
                    "@path": "/budget/slices"
                }
            },
            "x-stateSupport": [
                "focused",
                "hovered",
                "pressed"
            ]
        },
        "Sparkline": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "Sparkline"
                        },
                        "label": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "What the trend shows, announced by screen readers."
                        },
                        "modifier": {
                            "$ref": "anysdui_types.compose-charts.json#/$defs/ModifierOps",
                            "description": "Layout and styling modifiers to apply to the sparkline."
                        },
                        "values": {
                            "anyOf": [
                                {
                                    "items": {
                                        "type": "number"
                                    },
                                    "maxItems": 500,
                                    "type": "array"
                                },
                                {
                                    "$ref": "common_types.json#/$defs/DataBinding"
                                }
                            ],
                            "description": "The values in order. Bind it with a path, or give it inline."
                        }
                    },
                    "required": [
                        "component",
                        "label",
                        "values"
                    ]
                }
            ],
            "description": "Draws a small line of values with no axes, for a trend next to a number or in a list row.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "Sparkline",
                "id": "root",
                "label": "Price over the last 7 days",
                "modifier": [
                    {
                        "height": 24,
                        "type": "size",
                        "width": 96
                    }
                ],
                "values": {
                    "@path": "/price/week"
                }
            }
        }
    },
    "description": "Line, bar, pie and sparkline charts drawn from numbers in the data model.",
    "functions": {
        "and": {
            "description": "Performs a logical AND operation on a list of boolean values.",
            "properties": {
                "@call": {
                    "const": "and"
                },
                "args": {
                    "properties": {
                        "values": {
                            "description": "The list of boolean values to evaluate.",
                            "items": {
                                "$ref": "common_types.json#/$defs/DynamicBoolean"
                            },
                            "minItems": 2,
                            "type": "array"
                        }
                    },
                    "required": [
                        "values"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "boolean",
            "type": "object"
        },
        "email": {
            "description": "Checks that the value is a valid email address.",
            "properties": {
                "@call": {
                    "const": "email"
                },
                "args": {
                    "properties": {
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The string to check as an email address."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "validationResult",
            "type": "object"
        },
        "formatCurrency": {
            "description": "Formats a number as a currency string.",
            "properties": {
                "@call": {
                    "const": "formatCurrency"
                },
                "args": {
                    "properties": {
                        "currency": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The ISO 4217 currency code (e.g., 'USD', 'EUR')."
                        },
                        "decimals": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
                        },
                        "grouping": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "The monetary amount."
                        }
                    },
                    "required": [
                        "currency",
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "formatDate": {
            "description": "Formats a timestamp into a string using a pattern.",
            "properties": {
                "@call": {
                    "const": "formatDate"
                },
                "args": {
                    "properties": {
                        "format": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "A Unicode TR35 date pattern string.\n\nToken Reference:\n- Year: 'yy' (26), 'yyyy' (2026)\n- Month: 'M' (1), 'MM' (01), 'MMM' (Jan), 'MMMM' (January)\n- Day: 'd' (1), 'dd' (01), 'E' (Tue), 'EEEE' (Tuesday)\n- Hour (12h): 'h' (1-12), 'hh' (01-12) - requires 'a' for AM/PM\n- Hour (24h): 'H' (0-23), 'HH' (00-23) - Military Time\n- Minute: 'mm' (00-59)\n- Second: 'ss' (00-59)\n- Period: 'a' (AM/PM)\n\nExamples:\n- 'MMM dd, yyyy' -> 'Jan 16, 2026'\n- 'HH:mm' -> '14:30' (Military)\n- 'h:mm a' -> '2:30 PM'\n- 'EEEE, d MMMM' -> 'Friday, 16 January'"
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicValue",
                            "description": "The date to format."
                        }
                    },
                    "required": [
                        "format",
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "formatNumber": {
            "description": "Formats a number with the specified grouping and decimal precision.",
            "properties": {
                "@call": {
                    "const": "formatNumber"
                },
                "args": {
                    "properties": {
                        "decimals": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
                        },
                        "grouping": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "The number to format."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "formatString": {
            "description": "Performs string interpolation of data model values and other functions in the catalog functions list and returns the resulting string. The value string can contain interpolated expressions in the `${expression}` format. Supported expression types include: JSON Pointer paths to the data model (e.g., `${/absolute/path}` or `${relative/path}`), and renderer-side function calls (e.g., `${now()}`). Function arguments must be named (e.g., `${formatDate(value:${/currentDate}, format:'MM-dd')}`). To include a literal `${` sequence, escape it as `\\${`. An expression can also be a literal: a quoted string (`'text'` or `\"text\"`), a number (e.g., `-3.14`), `true` or `false`.",
            "properties": {
                "@call": {
                    "const": "formatString"
                },
                "args": {
                    "properties": {
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The template: text with embedded `${expression}` parts, where an expression is a JSON Pointer path, a literal (quoted string, number, `true` or `false`) or a function call with named arguments. Expressions nest, and `\\${` is a literal `${`."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "length": {
            "description": "Checks string length constraints.",
            "properties": {
                "@call": {
                    "const": "length"
                },
                "args": {
                    "anyOf": [
                        {
                            "required": [
                                "min"
                            ]
                        },
                        {
                            "required": [
                                "max"
                            ]
                        }
                    ],
                    "properties": {
                        "max": {
                            "description": "The maximum allowed length.",
                            "minimum": 0,
                            "type": "integer"
                        },
                        "min": {
                            "description": "The minimum allowed length.",
                            "minimum": 0,
                            "type": "integer"
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The string whose length is checked."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "validationResult",
            "type": "object"
        },
        "not": {
            "description": "Performs a logical NOT operation on a boolean value.",
            "properties": {
                "@call": {
                    "const": "not"
                },
                "args": {
                    "properties": {
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "description": "The boolean value to negate."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "boolean",
            "type": "object"
        },
        "numeric": {
            "description": "Checks numeric range constraints.",
            "properties": {
                "@call": {
                    "const": "numeric"
                },
                "args": {
                    "anyOf": [
                        {
                            "required": [
                                "min"
                            ]
                        },
                        {
                            "required": [
                                "max"
                            ]
                        }
                    ],
                    "properties": {
                        "max": {
                            "description": "The maximum allowed value.",
                            "type": "number"
                        },
                        "min": {
                            "description": "The minimum allowed value.",
                            "type": "number"
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "The number whose range is checked."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "validationResult",
            "type": "object"
        },
        "openUrl": {
            "allowedCallers": "rendererOnly",
            "description": "Opens the specified URL in a browser or handler (requires user activation). This function has no return value.",
            "properties": {
                "@call": {
                    "const": "openUrl"
                },
                "args": {
                    "properties": {
                        "url": {
                            "description": "The URL to open.",
                            "oneOf": [
                                {
                                    "format": "uri",
                                    "type": "string"
                                },
                                {
                                    "$ref": "common_types.json#/$defs/DataBinding"
                                },
                                {
                                    "$ref": "common_types.json#/$defs/FunctionCall"
                                }
                            ]
                        }
                    },
                    "required": [
                        "url"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "requiresUserActivation": true,
            "returnType": "void",
            "type": "object"
        },
        "or": {
            "description": "Performs a logical OR operation on a list of boolean values.",
            "properties": {
                "@call": {
                    "const": "or"
                },
                "args": {
                    "properties": {
                        "values": {
                            "description": "The list of boolean values to evaluate.",
                            "items": {
                                "$ref": "common_types.json#/$defs/DynamicBoolean"
                            },
                            "minItems": 2,
                            "type": "array"
                        }
                    },
                    "required": [
                        "values"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "boolean",
            "type": "object"
        },
        "pluralize": {
            "description": "Returns a localized string based on the Common Locale Data Repository (CLDR) plural category of the count (zero, one, two, few, many, other). Requires an 'other' fallback. For English, just use 'one' and 'other'.",
            "properties": {
                "@call": {
                    "const": "pluralize"
                },
                "args": {
                    "properties": {
                        "few": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "String for the 'few' category (e.g., small groups in Slavic languages)."
                        },
                        "many": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "String for the 'many' category (e.g., large groups in various languages)."
                        },
                        "one": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "String for the 'one' category (e.g., 1 item)."
                        },
                        "other": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The default/fallback string (used for general plural cases)."
                        },
                        "two": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "String for the 'two' category (used in Arabic, Welsh, etc.)."
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "The numeric value used to determine the plural category."
                        },
                        "zero": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "String for the 'zero' category (e.g., 0 items)."
                        }
                    },
                    "required": [
                        "value",
                        "other"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "regex": {
