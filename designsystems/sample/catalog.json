{
    "$defs": {
        "anyComponent": {
            "oneOf": [
                {
                    "$ref": "#/components/DsButton"
                },
                {
                    "$ref": "#/components/DsCard"
                },
                {
                    "$ref": "#/components/DsColumn"
                },
                {
                    "$ref": "#/components/DsIcon"
                },
                {
                    "$ref": "#/components/DsRow"
                },
                {
                    "$ref": "#/components/DsText"
                },
                {
                    "$ref": "#/components/DsTextField"
                },
                {
                    "$ref": "#/components/MaterialSymbol"
                }
            ]
        },
        "anyFunction": {
            "oneOf": [
                {
                    "$ref": "#/functions/and"
                },
                {
                    "$ref": "#/functions/email"
                },
                {
                    "$ref": "#/functions/formatCurrency"
                },
                {
                    "$ref": "#/functions/formatDate"
                },
                {
                    "$ref": "#/functions/formatNumber"
                },
                {
                    "$ref": "#/functions/formatString"
                },
                {
                    "$ref": "#/functions/length"
                },
                {
                    "$ref": "#/functions/not"
                },
                {
                    "$ref": "#/functions/numeric"
                },
                {
                    "$ref": "#/functions/openUrl"
                },
                {
                    "$ref": "#/functions/or"
                },
                {
                    "$ref": "#/functions/pluralize"
                },
                {
                    "$ref": "#/functions/regex"
                },
                {
                    "$ref": "#/functions/required"
                },
                {
                    "$ref": "#/functions/setTheme"
                },
                {
                    "$ref": "#/functions/setThemeMode"
                }
            ]
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "catalogId": "urn:anysdui:sample-designsystem:1.0.0",
    "components": {
        "DsButton": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "DsButton"
                        },
                        "content": {
                            "$ref": "common_types.json#/$defs/ChildList",
                            "description": "Composable content rendered inside the button row.",
                            "x-scope": "RowScope"
                        },
                        "enabled": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "default": true,
                            "description": "Whether the button responds to user interaction.",
                            "x-default": "true"
                        },
                        "loading": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "default": false,
                            "description": "Whether the button is in a loading state, suppressing click interactions.",
                            "x-default": "false"
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout modifiers applied to the button container."
                        },
                        "onClick": {
                            "$ref": "common_types.json#/$defs/Action",
                            "description": "Action callback triggered when the button is clicked."
                        },
                        "variant": {
                            "default": "primary",
                            "description": "Visual style variant determining background and content colors.",
                            "enum": [
                                "primary",
                                "secondary",
                                "ghost"
                            ],
                            "x-default": "DsButtonVariant.Primary",
                            "x-enumDescriptions": {
                                "ghost": "Transparent button showing text and/or icon in primary color.",
                                "primary": "Filled button using the primary theme color.",
                                "secondary": "Filled button using the accent theme color."
                            }
                        }
                    },
                    "required": [
                        "component",
                        "content",
                        "onClick"
                    ]
                }
            ],
            "description": "Standard button component for the AnySDUI Design System.\n\nExposes options for variants, enabled state, custom click actions, and content slot.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "DsButton",
                "content": [
                    "discard_label"
                ],
                "id": "discard_button",
                "onClick": {
                    "event": {
                        "name": "discard_profile"
                    }
                },
                "variant": "ghost"
            },
            "x-stateSupport": [
                "disabled",
                "focused",
                "hovered",
                "loading",
                "pressed"
            ]
        },
        "DsCard": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "DsCard"
                        },
                        "containerColor": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ColorRef",
                            "default": {
                                "type": "color",
                                "value": "surface"
                            },
                            "description": "Background color of the card container, defaulting to theme surface color.",
                            "x-default": "DsTheme.colors.surface"
                        },
                        "content": {
                            "$ref": "common_types.json#/$defs/ChildList",
                            "description": "Composable children displayed in a vertical column inside the card.",
                            "x-scope": "ColumnScope"
                        },
                        "contentColor": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ColorRef",
                            "default": {
                                "type": "color",
                                "value": "onSurface"
                            },
                            "description": "Preferred content and text color within the card, defaulting to theme onSurface color.",
                            "x-default": "DsTheme.colors.onSurface"
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout modifiers applied to the card container."
                        }
                    },
                    "required": [
                        "component",
                        "content"
                    ]
                }
            ],
            "description": "Standard card component for the AnySDUI Design System.\n\nProvides a bounded content container styled with the surface theme tokens.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-antiPatterns": [
                "Do not colour a card with a `background` modifier op — the card's own surface is drawn over it, leaving colour visible only in the corners its shape cuts away."
            ],
            "x-example": {
                "component": "DsCard",
                "content": [
                    "profile_column"
                ],
                "id": "root"
            },
            "x-invariants": [
                "An omitted or unresolvable `containerColor` resolves to `DsTheme.colors.surface` and an omitted or unresolvable `contentColor` to `DsTheme.colors.onSurface`, so a payload that sets neither renders exactly as it did before either parameter existed."
            ]
        },
        "DsColumn": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "DsColumn"
                        },
                        "content": {
                            "$ref": "common_types.json#/$defs/ChildList",
                            "description": "Composable children displayed sequentially from top to bottom.",
                            "x-scope": "ColumnScope"
                        },
                        "horizontalAlignment": {
                            "default": "start",
                            "description": "Horizontal alignment of children within the column cross-axis.",
                            "enum": [
                                "start",
                                "centerHorizontally",
                                "end"
                            ],
                            "x-default": "SduiHorizontalAlignment.Start"
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout modifiers applied to the column."
                        },
                        "spacing": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "default": 8,
                            "description": "Space in dp between adjacent children in the column.",
                            "x-default": "8"
                        },
                        "verticalArrangement": {
                            "default": "top",
                            "description": "Vertical arrangement strategy for positioning children.",
                            "enum": [
                                "top",
                                "center",
                                "bottom",
                                "spaceBetween",
                                "spaceAround",
                                "spaceEvenly"
                            ],
                            "x-default": "SduiVerticalArrangement.Top"
                        }
                    },
                    "required": [
                        "component",
                        "content"
                    ]
                }
            ],
            "description": "Standard vertical layout column for the AnySDUI Design System.\n\nPositions children vertically and applies spacing between them.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "DsColumn",
                "content": [
                    "profile_header",
                    "profile_bio",
                    "profile_name_field",
                    "profile_actions"
                ],
                "id": "profile_column",
                "modifier": [
                    {
                        "all": 16,
                        "type": "padding"
                    }
                ],
                "spacing": 12
            }
        },
        "DsIcon": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "DsIcon"
                        },
                        "icon": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/IconRef",
                            "description": "Vector graphic icon asset to render from the design system icon tokens."
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout modifiers applied to the icon."
                        },
                        "size": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "default": 24,
                            "description": "Dimensions in dp for width and height of the icon.",
                            "x-default": "24"
                        },
                        "tint": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ColorRef",
                            "default": {
                                "type": "color",
                                "value": "onSurface"
                            },
                            "description": "Color tint applied to the icon vector, defaulting to theme onSurface color.",
                            "x-default": "DsTheme.colors.onSurface"
                        }
                    },
                    "required": [
                        "component",
                        "icon"
                    ]
                }
            ],
            "description": "Standard icon container for the AnySDUI Design System.\n\nRenders an ImageVector at the specified dp size and applies the semantic tint.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "DsIcon",
                "icon": {
                    "type": "icon",
                    "value": "user"
                },
                "id": "profile_icon",
                "tint": {
                    "type": "color",
                    "value": "primary"
                }
            }
        },
        "DsRow": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "DsRow"
                        },
                        "content": {
                            "$ref": "common_types.json#/$defs/ChildList",
                            "description": "Composable slot for the row's children.",
                            "x-scope": "RowScope"
                        },
                        "horizontalArrangement": {
                            "default": "start",
                            "description": "Horizontal arrangement of children.",
                            "enum": [
                                "start",
                                "center",
                                "end",
                                "spaceBetween",
                                "spaceAround",
                                "spaceEvenly"
                            ],
                            "x-default": "SduiHorizontalArrangement.Start"
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout and styling modifiers to apply to the row."
                        },
                        "spacing": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "default": 8,
                            "description": "Spacing in dp between adjacent children.",
                            "x-default": "8"
                        },
                        "verticalAlignment": {
                            "default": "top",
                            "description": "Vertical alignment of children within the row.",
                            "enum": [
                                "top",
                                "centerVertically",
                                "bottom"
                            ],
                            "x-default": "SduiVerticalAlignment.Top"
                        }
                    },
                    "required": [
                        "component",
                        "content"
                    ]
                }
            ],
            "description": "Standard horizontal layout row for the AnySDUI Design System.\n\nPositions children horizontally and applies spacing between them.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "DsRow",
                "content": [
                    "profile_icon",
                    "profile_title"
                ],
                "id": "profile_header",
                "spacing": 8,
                "verticalAlignment": "centerVertically"
            }
        },
        "DsText": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "color": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ColorRef",
                            "default": {
                                "type": "color",
                                "value": "onSurface"
                            },
                            "description": "Color token to render the text with.",
                            "x-default": "DsTheme.colors.onSurface"
                        },
                        "component": {
                            "const": "DsText"
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout and styling modifiers to apply to the text."
                        },
                        "style": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/TypographyRef",
                            "default": {
                                "type": "typography",
                                "value": "body"
                            },
                            "description": "Typography style token to apply.",
                            "x-default": "DsTheme.typography.body"
                        },
                        "text": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The text content to display."
                        }
                    },
                    "required": [
                        "component",
                        "text"
                    ]
                }
            ],
            "description": "Standard text component for the AnySDUI Design System.\n\nRenders read-only text styled using the system's typography and color tokens.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "DsText",
                "id": "profile_title",
                "style": {
                    "type": "typography",
                    "value": "title"
                },
                "text": {
                    "@path": "/profile/name"
                }
            }
        },
        "DsTextField": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "DsTextField"
                        },
                        "enabled": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "default": true,
                            "description": "Whether the input field is interactive.",
                            "x-default": "true"
                        },
                        "label": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "Text label displayed above the input field."
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout and styling modifiers to apply to the container."
                        },
                        "placeholder": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "default": "",
                            "description": "Hint text displayed when the input field is empty.",
                            "x-default": "\"\""
                        },
                        "readOnly": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "default": false,
                            "description": "Whether the input field is read-only and non-editable.",
                            "x-default": "false"
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "Current text value of the input field.",
                            "x-twoWay": true
                        }
                    },
                    "required": [
                        "component",
                        "label",
                        "value"
                    ]
                }
            ],
            "description": "Standard text input field for the AnySDUI Design System.\n\nRenders a label above the text box, with support for placeholders, enabled state, and state-hoisted value change notification.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "DsTextField",
                "id": "profile_name_field",
                "label": "Display name",
                "placeholder": "Your name",
                "value": {
                    "@path": "/profile/draftName"
                }
            },
            "x-stateSupport": [
                "disabled",
                "focused",
                "hovered",
                "pressed",
                "readOnly"
            ]
        },
        "MaterialSymbol": {
            "allOf": [
                {
                    "$ref": "common_types.json#/$defs/ComponentCommon"
                },
                {
                    "properties": {
                        "component": {
                            "const": "MaterialSymbol"
                        },
                        "modifier": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ModifierOps",
                            "description": "Layout modifiers applied to the symbol."
                        },
                        "name": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "Ligature name of the symbol, for example `shopping_cart`."
                        },
                        "size": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "default": 24,
                            "description": "Width and height of the square in dp.",
                            "x-default": "24"
                        },
                        "tint": {
                            "$ref": "anysdui_types.sample-designsystem.json#/$defs/ColorRef",
                            "description": "Glyph colour, defaulting to the current content colour.",
                            "x-default": "androidx.compose.ui.graphics.Color.Unspecified"
                        }
                    },
                    "required": [
                        "component",
                        "name"
                    ]
                }
            ],
            "description": "Google Material Symbols glyph drawn by ligature name from the bundled variable font.",
            "type": "object",
            "unevaluatedProperties": false,
            "x-example": {
                "component": "MaterialSymbol",
                "id": "root",
                "name": "shopping_cart",
                "size": 24
            },
            "x-invariants": [
                "Draws within a square of size dp. An unspecified tint means the content colour."
            ]
        }
    },
    "description": "A standard Compose Multiplatform design system catalog for Server-Driven UI.",
    "functions": {
        "and": {
            "description": "Performs a logical AND operation on a list of boolean values.",
            "properties": {
                "@call": {
                    "const": "and"
                },
                "args": {
                    "properties": {
                        "values": {
                            "description": "The list of boolean values to evaluate.",
                            "items": {
                                "$ref": "common_types.json#/$defs/DynamicBoolean"
                            },
                            "minItems": 2,
                            "type": "array"
                        }
                    },
                    "required": [
                        "values"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "boolean",
            "type": "object"
        },
        "email": {
            "description": "Checks that the value is a valid email address.",
            "properties": {
                "@call": {
                    "const": "email"
                },
                "args": {
                    "properties": {
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The string to check as an email address."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "validationResult",
            "type": "object"
        },
        "formatCurrency": {
            "description": "Formats a number as a currency string.",
            "properties": {
                "@call": {
                    "const": "formatCurrency"
                },
                "args": {
                    "properties": {
                        "currency": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The ISO 4217 currency code (e.g., 'USD', 'EUR')."
                        },
                        "decimals": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
                        },
                        "grouping": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "The monetary amount."
                        }
                    },
                    "required": [
                        "currency",
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "formatDate": {
            "description": "Formats a timestamp into a string using a pattern.",
            "properties": {
                "@call": {
                    "const": "formatDate"
                },
                "args": {
                    "properties": {
                        "format": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "A Unicode TR35 date pattern string.\n\nToken Reference:\n- Year: 'yy' (26), 'yyyy' (2026)\n- Month: 'M' (1), 'MM' (01), 'MMM' (Jan), 'MMMM' (January)\n- Day: 'd' (1), 'dd' (01), 'E' (Tue), 'EEEE' (Tuesday)\n- Hour (12h): 'h' (1-12), 'hh' (01-12) - requires 'a' for AM/PM\n- Hour (24h): 'H' (0-23), 'HH' (00-23) - Military Time\n- Minute: 'mm' (00-59)\n- Second: 'ss' (00-59)\n- Period: 'a' (AM/PM)\n\nExamples:\n- 'MMM dd, yyyy' -> 'Jan 16, 2026'\n- 'HH:mm' -> '14:30' (Military)\n- 'h:mm a' -> '2:30 PM'\n- 'EEEE, d MMMM' -> 'Friday, 16 January'"
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicValue",
                            "description": "The date to format."
                        }
                    },
                    "required": [
                        "format",
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "formatNumber": {
            "description": "Formats a number with the specified grouping and decimal precision.",
            "properties": {
                "@call": {
                    "const": "formatNumber"
                },
                "args": {
                    "properties": {
                        "decimals": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
                        },
                        "grouping": {
                            "$ref": "common_types.json#/$defs/DynamicBoolean",
                            "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
                        },
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicNumber",
                            "description": "The number to format."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "formatString": {
            "description": "Performs string interpolation of data model values and other functions in the catalog functions list and returns the resulting string. The value string can contain interpolated expressions in the `${expression}` format. Supported expression types include: JSON Pointer paths to the data model (e.g., `${/absolute/path}` or `${relative/path}`), and renderer-side function calls (e.g., `${now()}`). Function arguments must be named (e.g., `${formatDate(value:${/currentDate}, format:'MM-dd')}`). To include a literal `${` sequence, escape it as `\\${`. An expression can also be a literal: a quoted string (`'text'` or `\"text\"`), a number (e.g., `-3.14`), `true` or `false`.",
            "properties": {
                "@call": {
                    "const": "formatString"
                },
                "args": {
                    "properties": {
                        "value": {
                            "$ref": "common_types.json#/$defs/DynamicString",
                            "description": "The template: text with embedded `${expression}` parts, where an expression is a JSON Pointer path, a literal (quoted string, number, `true` or `false`) or a function call with named arguments. Expressions nest, and `\\${` is a literal `${`."
                        }
                    },
                    "required": [
                        "value"
                    ],
                    "type": "object",
                    "unevaluatedProperties": false
                }
            },
            "required": [
                "@call",
                "args"
            ],
            "returnType": "string",
            "type": "object"
        },
        "length": {
            "description": "Checks string length constraints.",
            "properties": {
                "@call": {
